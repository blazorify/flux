@inherits FluxComponent

<div data-testid="counter">@LastObservedCounter</div>

@code {
	public int LastObservedCounter { get; private set; } = -1;

	public bool OwnResourcesReleased { get; private set; }

	protected override void OnInitialized()
	{
		base.OnInitialized();
		this.Subscribe<ComponentTestState>(state =>
		{
			this.LastObservedCounter = state.Counter;
		});
	}

	public override async ValueTask DisposeAsync()
	{
		this.OwnResourcesReleased = true;
		await base.DisposeAsync();
	}
}
