@inherits FluxComponent

<div data-testid="renders">@Renders</div>

@code {
	public int Renders { get; private set; }

	protected override void OnInitialized()
	{
		base.OnInitialized();
		this.Subscribe<ComponentTestState>(state =>
		{
			if (state.Counter > 0)
			{
				throw new InvalidOperationException("component callback failure");
			}
		});
	}

	protected override void OnAfterRender(bool firstRender)
	{
		this.Renders++;
	}
}
