###############################################################################
# Default behavior
###############################################################################
# Auto-detect text files and normalize to LF in repo
* text=auto eol=lf

###############################################################################
# .NET source code
###############################################################################
*.cs         text eol=lf
*.csx        text eol=lf
*.fs         text eol=lf
*.fsx        text eol=lf
*.vb         text eol=lf

###############################################################################
# Project & solution files
###############################################################################
*.sln        text eol=crlf
*.csproj     text eol=lf
*.fsproj     text eol=lf
*.vbproj     text eol=lf
*.props      text eol=lf
*.targets    text eol=lf

###############################################################################
# Config & data files
###############################################################################
*.json         text eol=lf
*.jsonc        text eol=lf
*.yaml         text eol=lf
*.yml          text eol=lf
*.xml          text eol=lf
*.config       text eol=lf
*.ini          text eol=lf
*.editorconfig text eol=lf

###############################################################################
# Scripts
###############################################################################
*.sh        text eol=lf
*.bash      text eol=lf
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

###############################################################################
# Web / frontend (often present in .NET repos)
###############################################################################
*.razor     text eol=lf
*.cshtml    text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.vue       text eol=lf

###############################################################################
# Docker & CI
###############################################################################
Dockerfile          text eol=lf
Dockerfile.*        text eol=lf
*.dockerfile        text eol=lf
docker-compose*.yml text eol=lf
*.env               text eol=lf

###############################################################################
# Docs
###############################################################################
*.md        text eol=lf
*.txt       text eol=lf
*.rst       text eol=lf

###############################################################################
# Binary files (never modify)
###############################################################################
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.webp      binary

*.pdf       binary
*.zip       binary
*.7z        binary
*.tar       binary
*.gz        binary

*.dll       binary
*.exe       binary
*.pdb       binary
*.nupkg     binary
*.snupkg    binary
