@page "/flux-counter"
@inherits FluxComponent

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>

<p role="status">Current count: @currentCount</p>

<button class="btn btn-primary" @onclick="IncrementCount">
	Increment
</button>

<button class="btn btn-primary" @onclick="DecrementCount">
	Decrement
</button>

@code {
	private int currentCount = 0;

	protected override void OnInitialized()
	{
		base.OnInitialized();

		this.Subscribe<CounterState>(state =>
		{
			this.currentCount = state.CurrentCount;
		});
	}

	private void IncrementCount()
	{
		this.Dispatch<CounterActions.Increment>();
	}

	private void DecrementCount()
	{
		this.Dispatch<CounterActions.Decrement>();
	}
}
